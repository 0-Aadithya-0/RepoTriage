# =============================================================================
# RepoTriage - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME=RepoTriage
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- GitHub -----------------------------------------------------------------
# Optional: GitHub Personal Access Token for higher rate limits (60 -> 5000 req/hr).
# Strongly recommended -- unauthenticated requests share a pool of only 60 req/hr.
# Generate one at: https://github.com/settings/tokens (no scopes required for public repos)
# GITHUB_TOKEN=ghp_your_token_here

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_SECONDS=15.0

# ---- LLM Provider -----------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_CONCURRENCY=3
LLM_MAX_RETRIES=3

# ---- Provider API Keys -------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Prompt Configuration ---------------------------------------------------
PROMPTS_FILE=prompts.yaml

# ---- Content Truncation -----------------------------------------------------
MAX_ISSUE_BODY_LENGTH=4096
